# 基本配置
APP_NAME=interactive-bot
BOT_TOKEN=7126xxxxxxxxxxxxxxxxxxxf4He_BbQ



# 业务配置
WELCOME_MESSAGE="你好，我是米哈（ @MrMiHa ）。\n请问有什么可以帮助你的吗？\n和这个示例机器人对话后，可以前往：https://t.me/MiHaCMSGroup 查看效果。\n有问题，请访问：https://github.com/MiHaKun/Telegram-interactive-bot 查看代码或提出issue（顺便求star）"
# 各类内置ID可以通过 @GetTheirIDBot 获取
ADMIN_GROUP_ID=-1002234110823
ADMIN_USER_IDS=1281631753,1022318030

# 删除话题时是否永久封禁（无法恢复了） TRUE 开启
DELETE_TOPIC_AS_FOREVER_BAN=FALSE

# 利用 /clear 清理后台和用户侧的所有消息（不推荐） TRUE 开启
DELETE_USER_MESSAGE_ON_CLEAR_CMD=TRUE

# 是否禁用人机识别 TRUE 禁用
DISABLE_CAPTCHA=FALSE

# 防止无聊客户不停刷消息。单位：秒。0为不限制
MESSAGE_INTERVAL=3

# 新用户发起私聊时发送通知的话题。留空 = 发到 General（General 没有 ID，不需要填）；填写数字 = 发到指定子话题
# GENERAL_TOPIC_ID=



# ===== Discord 同步（可选，不填 DISCORD_BOT_TOKEN 则不启用） =====
# Discord 机器人 Token（开发者后台 → Bot，需开启 Message Content Intent）
# DISCORD_BOT_TOKEN=
# 接收私聊的论坛（Forum）频道 ID，每个 TG 用户对应其中一个帖子
# DISCORD_FORUM_CHANNEL_ID=
# 可选：新用户发起私聊时发通知的文字频道 ID
# DISCORD_NOTIFY_CHANNEL_ID=
# 可选：允许在帖子里回复用户的角色 ID，多个用“,”分隔；留空 = 能在帖子里发言的人都可以
# DISCORD_ADMIN_ROLE_IDS=

# 可选但推荐（https://my.telegram.org 申请，任意账号均可）。以机器人身份登录 MTProto，用于：
# 迁移历史话题、同步超过 20MB 的文件到 Discord、把 Discord 上超过 50MB（最大 2GB）的文件发给用户、重启后补发
# TG_API_ID=
# TG_API_HASH=

# 可选：Discord 消息显示用户的真实头像。填公网能访问到本程序头像服务的地址（推荐域名 + HTTPS 反向代理到 AVATAR_PORT），
# 并在 docker-compose.yml 里映射端口。不填时：有公开用户名且头像公开的用户用 Telegram 公开头像，其余用默认头像
# AVATAR_PUBLIC_URL=https://avatar.example.com
# AVATAR_PORT=8080

# 可选：代理（仅支持 http 代理；Docker 内访问宿主机代理用 host.docker.internal）
# HTTPS_PROXY=http://host.docker.internal:10809